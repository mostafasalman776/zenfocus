# Copy to .env. Never commit the real file.
NODE_ENV=development
HOST=127.0.0.1
PORT=5090
# Public origin of the web app (used for OAuth redirects and CORS).
APP_ORIGIN=http://localhost:5173
# Leave empty in development to use an embedded PGlite database in ./.pglite
DATABASE_URL=
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only: enables POST /api/auth/dev-login. Never set in production.
DEV_LOGIN=1
# Where chat images are stored, and the key that signs their URLs (openssl rand -hex 32).
UPLOAD_DIR=./uploads
IMAGE_SECRET=
# Production: let Nginx serve images (internal location).
ACCEL_REDIRECT_PREFIX=
# Usernames that can review reports, comma-separated.
ADMIN_USERNAMES=
# Voice (LiveKit). Empty = voice disabled.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
